{
  "manifest_version": 3,
  "name": "Nikola Autofill",
  "version": "1.0.0",
  "description": "Local AI autofill for web forms - no cloud, fully private",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://localhost:8000/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Nikola Autofill"
  }
}
