# Nikola Environment Configuration
# Copy this file to .env and fill in your values

# Backend Configuration
LLAMA_CPP_MODEL_PATH=C:/nikola/backend/models/Qwen3-1.7B-Q4_K_M.gguf
LLAMA_SERVER_URL=http://127.0.0.1:8080/v1
BACKEND_URL=http://localhost:8000

# File Paths & RAG
VAULT_PATH=~/vault
CHROMA_PATH=~/nikola_chroma
CHROMA_COLLECTION=nikola_documents_v2

# Telegram Bot Configuration
BOT_TOKEN=your_bot_token_here
ALLOWED_USER_ID=your_telegram_user_id_here

# Voice Engine Configuration
VOICE_ENABLED=true
WAKE_WORD=hey nikola
WHISPER_MODEL=base
TTS_ENGINE=piper

# AI Model Configuration
EMBEDDING_MODEL=Qwen3-Embedding-0.6B
VISION_MODEL=moondream

# Security
NIKOLA_API_KEY=nikola-dev-secret-key
AUTOFILL_ENCRYPTION_KEY=your_fernet_encryption_key_here

# Optional Features
RUN_COMMANDS=false
DEBUG=false
ALLOWED_TELEGRAM_IDS=

